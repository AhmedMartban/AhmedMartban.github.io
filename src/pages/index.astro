---
import "../styles/global.css";

const name = "Ahmed Martban";
const role = "Robotics (ROS2) & AI Engineer";
const location = "Berlin, Germany";
const intro =
  "I build deployable robotics systems with a focus on ROS2 system integration, social navigation, and AI (LLMs/CV) under real-time constraints.";

const links = [
  { label: "GitHub", href: "https://github.com/AhmedMartban" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/YOUR_LINKEDIN/" },
  { label: "Email", href: "mailto:YOUR_EMAIL" },
];

const projects = [
  {
    title: "Learning-based Social Navigation (ROS2)",
    venue: "Master’s Thesis • Arena-Rosnav / Nav2",
    desc: "Integration and benchmarking of learning-based planners for human-aware navigation in dense, dynamic environments.",
    tags: ["ROS2", "Nav2", "Gazebo", "DRL", "Benchmarking"],
    buttons: [
      { label: "Code", href: "https://github.com/AhmedMartban" },
      { label: "Report", href: "#" },
    ],
  },
  {
    title: "HuNav Gazebo Plugins (Garden Migration)",
    venue: "Engineering • Simulation Plugins",
    desc: "Migration and refactoring of Gazebo plugins from Fortress to Garden with ROS2 compatibility.",
    tags: ["C++", "Gazebo Garden", "ROS2", "Simulation"],
    buttons: [{ label: "Code", href: "https://github.com/AhmedMartban" }],
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{name} — {role}</title>
    <meta name="description" content="Portfolio of Ahmed Martban — Robotics (ROS2), AI, and autonomous systems." />
  </head>

  <body>
    <!-- NAV -->
    <header class="nav">
      <div class="container nav-inner">
        <a class="brand" href="#top">&lt;/&gt;</a>
        <nav class="nav-links">
          <a href="#projects">Projects</a>
          <a href="#research">Research</a>
          <a href="#contact">Contact</a>
        </nav>
        <div class="nav-right">
          <span class="pill">Open to opportunities</span>
        </div>
      </div>
    </header>

    <main id="top" class="container page">
      <!-- HERO GRID -->
	<section class="hero">
	<div class="hero-left">
		<div class="kicker">{role}</div>
		<h1 class="h1">{name}</h1>
		<p class="lead">{intro}</p>

		<div class="meta">
		<span class="dot"></span>
		<span class="muted">{location}</span>
		</div>

		<div class="socials">
		<a class="github" href="https://github.com/AhmedMartban" target="_blank" rel="noreferrer">
			<img src="/icons/github.svg" alt="GitHub" />
		</a>

		<a href="https://www.linkedin.com/in/ahmed-martban-377aa814b" target="_blank" rel="noreferrer">
			<img src="/icons/linkedin.svg" alt="LinkedIn" />
		</a>

		<a href="https://www.youtube.com/" target="_blank" rel="noreferrer">
			<img src="/icons/youtube.svg" alt="YouTube" />
		</a>

		<a class="email" href="mailto:YOUR_EMAIL">
			<img src="/icons/email.svg" alt="Email" />
		</a>

		<a href="https://www.researchgate.net/" target="_blank" rel="noreferrer">
			<img src="/icons/researchgate.svg" alt="ResearchGate" />
		</a>
		</div>
	</div>

	<div class="hero-right">
		<div class="avatar-ring">
		<img class="avatar" src="/profile.jpg" alt="Ahmed Martban profile photo" />
		</div>
	</div>
	</section>



      <!-- PROJECTS -->
      <section id="projects" class="section">
        <h2 class="h2">Projects</h2>
        <p class="muted">Case-study style summaries with architecture, challenges, and measurable performance.</p>

        <div class="stack">
          {projects.map((p) => (
            <article class="card2">
              <div class="card2-top">
                <div>
                  <h3 class="h3">{p.title}</h3>
                  <div class="muted small">{p.venue}</div>
                </div>
                <div class="btn-row">
                  {p.buttons?.map((b) => (
                    <a class="chip" href={b.href} target="_blank" rel="noreferrer">{b.label}</a>
                  ))}
                </div>
              </div>

              <p class="muted">{p.desc}</p>
              <div class="tags">
                {p.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- RESEARCH (Placeholder) -->
      <section id="research" class="section">
        <h2 class="h2">Research</h2>
        <p class="muted">Selected publications and contributions.</p>

        <article class="card2">
          <div class="card2-top">
            <div>
              <h3 class="h3">Arena-Rosnav / Arena-Bench Contributions</h3>
              <div class="muted small">Social Navigation • ROS2 Simulation • Benchmarking</div>
            </div>
            <div class="btn-row">
              <a class="chip" href="#" target="_blank" rel="noreferrer">Paper</a>
              <a class="chip" href="#" target="_blank" rel="noreferrer">Code</a>
            </div>
          </div>
          <p class="muted">
            Benchmarks and tooling around navigation in collaborative, dynamic environments.
          </p>
        </article>
      </section>

      <!-- CONTACT -->
      <section id="contact" class="section">
        <h2 class="h2">Contact</h2>
        <p class="muted">
          Email: <a class="link" href="mailto:YOUR_EMAIL">YOUR_EMAIL</a>
        </p>
      </section>

      <footer class="footer muted">
        © {new Date().getFullYear()} Ahmed Martban
      </footer>
    </main>
  </body>
</html>
